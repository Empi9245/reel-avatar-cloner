# ElevenLabs API Configuration for Voice Reference Generation (Phase C)
# Copy this file to `.env` in the project root and fill in your credentials.

# Your ElevenLabs API key (from https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Chosen Voice ID from your ElevenLabs Voice Library or Voice Design
ELEVENLABS_VOICE_ID=your_voice_id_here

# Model ID supporting Audio Tags [curious], [whispers], [laughs], etc.
# Default: eleven_v4 (or eleven_v3 if your workspace uses v3)
ELEVENLABS_MODEL_ID=eleven_v4
